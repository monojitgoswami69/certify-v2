# =============================================================================
# WeCertify™ Background Worker (Heroku Private Dyno)
# =============================================================================
# Copy to .env inside worker/ when running locally:
#   cd worker && node --env-file=.env dist/worker/src/index.js

# Dedicated least-privilege Postgres role URL (see worker/sql/create-worker-role.sql).
WORKER_DATABASE_URL=postgresql://certify_worker:CHANGE_ME@ep-xxx-pooler.region.aws.neon.tech/certify?sslmode=require

# Same Google OAuth Web Client used by Vercel.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Shared AES-256-GCM 64-hex key (MUST match Vercel's WORKER_HANDOFF_KEY).
WORKER_HANDOFF_KEY=

# Public app origin fallback for verification QR URLs.
NEXT_PUBLIC_APP_URL=https://wecertify.tech

# Optional Cloudflare R2 read access for private/signed full-resolution templates.
# R2_ACCOUNT_ID=
# R2_BUCKET=wecertify
R2_PUBLIC_BASE_URL=https://assets.wecertify.tech
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Worker tuning (512 MB Heroku Basic defaults)
WORKER_POLL_INTERVAL_MS=2500
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=20
WORKER_SEND_CONCURRENCY=1
WORKER_MEMORY_SOFT_LIMIT_MB=420
