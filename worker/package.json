{
  "name": "wecertify-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Private background certificate rendering and Gmail delivery worker for WeCertify",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker/src/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.78",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
