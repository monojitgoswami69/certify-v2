# =============================================================================
# WeCertify™ — Environment Variables
# =============================================================================
# Copy this file to ".env" and fill in real values. Your real .env contains
# secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET) — it is gitignored and must
# never be committed. This template is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth 2.0  (REQUIRED)
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Must be a "Web application" client with your site origin listed under
# "Authorized JavaScript origins". The NEXT_PUBLIC_ prefix exposes it to the
# browser, which is required for Google Identity Services (the connect button).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-side OAuth client secret — used to exchange the auth code for tokens
# (including the refresh token that keeps the Gmail connection alive without
# weekly reconnections). NEVER expose this to the browser (no NEXT_PUBLIC_).
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Optional: a server-only client ID, used only if NEXT_PUBLIC_GOOGLE_CLIENT_ID
# is unset. Leave blank to reuse the NEXT_PUBLIC_ value above.
# GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# App Session Security  (REQUIRED)
# -----------------------------------------------------------------------------
# Secret used to sign the app's own login JWT (7-day "remember me" / 24h
# session). REQUIRED in production and must be at least 32 characters, otherwise
# every authenticated request is rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars

# How many reverse proxies sit in front of the app (nginx, Vercel, Cloudflare,
# ...). Rate limiting reads the client IP from X-Forwarded-For counting from
# the END of the list, because only entries appended by YOUR proxies are
# trustworthy — the head of the list is client-controlled. Set to 0 ONLY if
# the app is directly exposed to the internet with no proxy in front
# (forwarding headers are then ignored entirely).
TRUSTED_PROXY_COUNT=1

# The platform super admin. Manage allowed sign-in emails and their Gmail
# sending limits in Admin → Access. Other users sign in with allowlisted Google
# accounts. Leave AUTH_PASSWORD unset to use Google sign-in for the admin too.
ADMIN_EMAIL=you@organization.com
# AUTH_PASSWORD=

# Dedicated server-side key for Gmail tokens. Use the same key on every
# instance and keep it in the deployment's secret manager. Replacing it
# requires each sender to reauthorize Gmail.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GMAIL_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# QR Certificate Verification  (REQUIRED for QR mode)
# -----------------------------------------------------------------------------
# Neon Postgres connection string (use the POOLED url, it ends in "-pooler").
# Neon Console -> your project -> Connection Details -> Pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/certify?sslmode=require

# App origin for Gmail authorization and fallback for issuance from preview hosts.
# In Vercel Production, set this to https://wecertify.tech.
# Issuing on a public WeCertify domain saves that origin with the event.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Emergency verification notice. Set to true on the server and redeploy to enable.
VERIFY_MAINTENANCE=false

# -----------------------------------------------------------------------------
# Certificate Verification Branding (OPTIONAL)
# -----------------------------------------------------------------------------
# Organization or entity name shown under "Issued By" on the verification page.
# Defaults to "WeCertify" if left blank.
ISSUED_BY=WeCertify
NEXT_PUBLIC_ISSUED_BY=WeCertify
