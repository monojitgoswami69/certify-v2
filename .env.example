# =============================================================================
# Certify™ — Environment Variables
# =============================================================================
# Copy this file to ".env" and fill in real values. Your real .env contains
# secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET) — it is gitignored and must
# never be committed. This template is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth 2.0  (REQUIRED)
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Must be a "Web application" client with your site origin listed under
# "Authorized JavaScript origins". The NEXT_PUBLIC_ prefix exposes it to the
# browser, which is required for Google Identity Services (the connect button).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-side OAuth client secret — used to exchange the auth code for tokens
# (including the refresh token that keeps the Gmail connection alive without
# weekly reconnections). NEVER expose this to the browser (no NEXT_PUBLIC_).
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Optional: a server-only client ID, used only if NEXT_PUBLIC_GOOGLE_CLIENT_ID
# is unset. Leave blank to reuse the NEXT_PUBLIC_ value above.
# GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# App Session Security  (REQUIRED)
# -----------------------------------------------------------------------------
# Secret used to sign the app's own login JWT (7-day expiry). Set a long random
# string in production. A loud warning is logged at startup if this is unset.
JWT_SECRET=change_me_to_a_long_random_string

# Credentials for the username/password sign-in path (Google sign-in also works
# and uses the Google vars above). Change these from the defaults in production.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Gmail API Throughput Tuning  (OPTIONAL — sensible defaults baked into the app)
# -----------------------------------------------------------------------------
# These match your Gmail API per-user quota so the client limiter doesn't fight
# the quota (which causes 429-retry waste). Override only to tune.
#
# Cloud Console → IAM & Admin → Quotas → Gmail API → "Units per minute per user".
# messages.send costs 100 quota units, so (quota / 100) = max sends per minute.
# Default 145 sits just under the common 15,000-unit quota (~150/min ~ 2.5/sec).
# Raise this if you raise your Cloud Console quota.
NEXT_PUBLIC_GMAIL_QUOTA_PER_MINUTE=145

# Max sends started per second (burst cap). Prevents pathological sub-second
# spikes; the network round-trip usually caps you well below this anyway.
NEXT_PUBLIC_GMAIL_BURST_PER_SECOND=8

# -----------------------------------------------------------------------------
# QR Certificate Verification  (REQUIRED for QR mode)
# -----------------------------------------------------------------------------
# Neon Postgres connection string (use the POOLED url, it ends in "-pooler").
# Neon Console -> your project -> Connection Details -> Pooled connection.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/certify?sslmode=require

# Public origin encoded inside every QR code. Scanners are sent to
# {NEXT_PUBLIC_APP_URL}/verify/<certificate-id>. Must be the production
# domain in deployment — QR codes printed with the wrong origin can't verify.
NEXT_PUBLIC_APP_URL=http://localhost:3000
